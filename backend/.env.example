# Banco (obrigatório)
# Docker local: postgresql://benny:benny_dev_secret@localhost:5433/benny?sslmode=disable
# Produção: connection string do Postgres no Coolify/servidor
DATABASE_URL=postgresql://user:password@host:5432/benny?sslmode=disable

# Servidor
PORT=3011
NODE_ENV=production

# Single-tenant (padrão: 1)
DEFAULT_TENANT_ID=1
SKIP_DB_INIT_DDL=true

# JWT — mínimo 32 caracteres em produção
JWT_SECRET=altere-esta-chave-com-pelo-menos-32-caracteres-aleatorios
JWT_EXPIRES_IN=7d

# ── Notaas (provedor fiscal NFS-e) ───────────────────────────────────────────
# Dashboard: https://platform.notaas.com.br — Docs: https://docs.notaas.com.br
# Guia: docs/MIGRACAO_NOTAAS.md
NOTAAS_API_KEY=
NOTAAS_API_URL=https://platform.notaas.com.br/api/v1
NOTAAS_CNPJ_EMITENTE=55961553000100
NOTAAS_AMBIENTE=homologacao
NOTAAS_CODIGO_MUNICIPIO_IBGE=4105805
NOTAAS_C_TRIB_NAC=310103
NOTAAS_C_NBS=120013110
NOTAAS_ALIQUOTA_ISS=2
NOTAAS_NFE_ENABLED=false
# NOTAAS_NFSE_INCLUIR_PECAS=true
# NOTAAS_TOMADOR_CPF=
# NOTAAS_TOMADOR_CNPJ=
# NOTAAS_TOMADOR_CEP=
# NOTAAS_TOMADOR_C_MUN=
# NOTAAS_ISS_RETIDO=false

# Consulta de veículo por placa
WDAPI2_TOKEN=
