# Banco (obrigatório)
# Docker local: postgresql://benny:benny_dev_secret@localhost:5433/benny?sslmode=disable
# Produção: connection string do Postgres no Coolify/servidor
DATABASE_URL=postgresql://user:password@host:5432/benny?sslmode=disable

# Servidor
PORT=3011
NODE_ENV=production

# Tenancy
# true (omitido) = uma oficina por deploy; false = SaaS multi-oficina (JWT tenantId)
SINGLE_TENANT_MODE=false
DEFAULT_TENANT_ID=1
SKIP_DB_INIT_DDL=true

# URLs públicas (Checkout / Portal / CORS)
FRONTEND_URL=https://benny.jwsoftware.com.br
# API_PUBLIC_URL=https://api-benny.jwsoftware.com.br

# Stripe (NUNCA commitar sk_live_ / whsec_ — só Coolify/Secrets)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=price_
STRIPE_PRICE_PREMIUM=price_
STRIPE_PRICE_ENTERPRISE=price_

# JWT — mínimo 32 caracteres em produção
JWT_SECRET=altere-esta-chave-com-pelo-menos-32-caracteres-aleatorios
JWT_EXPIRES_IN=7d

# Cookie de sessão (híbrido com Bearer). Em produção multi-domínio:
# COOKIE_DOMAIN=.jwsoftware.com.br
# COOKIE_SAME_SITE=none
# COOKIE_DOMAIN=
# COOKIE_SAME_SITE=lax

# Backup: o serviço tenta `pg_dump` (formato .dump). A imagem Docker inclui
# postgresql-client. Sem o cliente no PATH, cai no fallback JSON completo
# (todas as tabelas de negócio em backend/backups/).
# Remoto opcional (S3 / R2 / B2 / MinIO) — sem bucket, só local:
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_PREFIX=backups/

# ── Notaas (provedor fiscal NFS-e) ───────────────────────────────────────────
# Dashboard: https://platform.notaas.com.br — Docs: https://docs.notaas.com.br
# Guia: docs/MIGRACAO_NOTAAS.md
NOTAAS_API_KEY=
NOTAAS_API_URL=https://platform.notaas.com.br/api/v1
NOTAAS_CNPJ_EMITENTE=55961553000100
NOTAAS_AMBIENTE=homologacao
NOTAAS_CODIGO_MUNICIPIO_IBGE=4105805
NOTAAS_C_TRIB_NAC=310103
NOTAAS_C_NBS=120013110
NOTAAS_ALIQUOTA_ISS=2
NOTAAS_NFE_ENABLED=false
# NOTAAS_NFSE_INCLUIR_PECAS=true
# NOTAAS_TOMADOR_CPF=
# NOTAAS_TOMADOR_CNPJ=
# NOTAAS_TOMADOR_CEP=
# NOTAAS_TOMADOR_C_MUN=
# NOTAAS_ISS_RETIDO=false

# Consulta de veículo por placa
WDAPI2_TOKEN=
