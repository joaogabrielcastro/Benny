# Banco (obrigatório)
# Docker local: postgresql://benny:benny_dev_secret@localhost:5433/benny?sslmode=disable
# Produção: connection string do Postgres no Coolify/servidor
DATABASE_URL=postgresql://user:password@host:5432/benny?sslmode=disable

# Servidor
PORT=3011
NODE_ENV=production

# Single-tenant (padrão: 1)
DEFAULT_TENANT_ID=1
SKIP_DB_INIT_DDL=true

# JWT — mínimo 32 caracteres em produção
JWT_SECRET=altere-esta-chave-com-pelo-menos-32-caracteres-aleatorios
JWT_EXPIRES_IN=7d

# Nuvem Fiscal — credenciais API (console.nuvemfiscal.com.br)
NUVEM_FISCAL_CLIENT_ID=
NUVEM_FISCAL_CLIENT_SECRET=
NUVEM_FISCAL_CNPJ_EMITENTE=55961553000100
NUVEM_FISCAL_AMBIENTE=homologacao
# Sandbox: https://api.sandbox.nuvemfiscal.com.br | Produção: https://api.nuvemfiscal.com.br
NUVEM_FISCAL_API_URL=https://api.sandbox.nuvemfiscal.com.br
NUVEM_FISCAL_CODIGO_MUNICIPIO_IBGE=4105805
NUVEM_FISCAL_C_TRIB_NAC=140101
NUVEM_FISCAL_C_NBS=120013110
NUVEM_FISCAL_ALIQUOTA_ISS=2
# tpRetISSQN: 1=sem retenção (ME/EPP Simples — não envia pAliq na DPS)
NUVEM_FISCAL_TP_RET_ISSQN=1
# NUVEM_FISCAL_FORCAR_ALIQ_ISS_DPS=false
# Simples (opSimpNac/regApTribSN): painel Nuvem → empresa → NFS-e
# NUVEM_FISCAL_REG_ESP_TRIB=0
# NUVEM_FISCAL_TOMADOR_CEP=83411100

# NF-e (peças) — desativada por padrão até SEFAZ/PR (CSRT). Ativar: NUVEM_FISCAL_NFE_ENABLED=1
# Com NF-e desligada, NFS-e inclui serviços + peças (valor total). Override: NUVEM_FISCAL_NFSE_INCLUIR_PECAS=0
# NUVEM_FISCAL_NFE_ENABLED=false
NUVEM_FISCAL_EMITENTE_IE=
NUVEM_FISCAL_NFE_CRT=1
NUVEM_FISCAL_NFE_NUMERO_INICIAL=1
# Responsável técnico do ERP (obrigatório NF-e — SEFAZ PR rejeição 972)
# CNPJ do DESENVOLVEDOR do software (não o CNPJ da oficina)
NUVEM_FISCAL_RESP_TEC_CNPJ=
NUVEM_FISCAL_RESP_TEC_CONTATO=
NUVEM_FISCAL_RESP_TEC_EMAIL=
NUVEM_FISCAL_RESP_TEC_FONE=
# PR (obrigatório — rejeição 975): token em Receita/PR → UPD → Sistema → CSRT (Fornecedor)
# NUVEM_FISCAL_RESP_TEC_CSRT_ID=1
# NUVEM_FISCAL_RESP_TEC_CSRT=
# NUVEM_FISCAL_NFE_CFOP=5102
# NUVEM_FISCAL_NFE_CSOSN=103
# NUVEM_FISCAL_NFE_NCM=87089990
# NUVEM_FISCAL_NFE_SERIE=1
# NUVEM_FISCAL_CUF=41

# Consulta de veículo por placa (botão "Buscar pela placa" no cadastro de veículo/OS)
# wdapi2.com.br — token normal no Painel do Usuário; GET https://wdapi2.com.br/consulta/{placa}/{token}
WDAPI2_TOKEN=
# WDAPI2_TOKEN_PREMIUM= — reservado; consultas premium usam token separado (não usado pelo Benny hoje)
# Alternativas (opcional): PLACAFIPE_TOKEN= | FIPE_PLACA_API_KEY=
# CONSULTA_PLACA_SOMENTE_GRATIS=1 — ignora provedores pagos e usa só WDAPI2 / URL gratuita
