FROM node:22-bookworm-slim
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

COPY package.json ./
RUN npm install

COPY . .

RUN mkdir -p storage

ENV NODE_ENV=development
EXPOSE 3011

ENTRYPOINT ["node", "docker-entrypoint.mjs"]
CMD ["npm", "run", "dev"]
