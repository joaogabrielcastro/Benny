# Copie para .env.docker e ajuste se necessário:
#   cp .env.docker.example .env.docker
#
# Suba o ambiente:
#   docker compose --env-file .env.docker up --build
#
# Modo desenvolvimento (hot reload):
#   docker compose --env-file .env.docker -f docker-compose.yml -f docker-compose.dev.yml up --build

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=benny
POSTGRES_PASSWORD=benny_dev_secret
POSTGRES_DB=benny

# ── Backend ───────────────────────────────────────────────────────────────────
JWT_SECRET=docker-dev-jwt-secret-minimo-32-caracteres
JWT_EXPIRES_IN=7d
DEFAULT_TENANT_ID=1
SKIP_DB_INIT_DDL=true
DOCKER_BOOTSTRAP_DB=true

# Login padrão criado automaticamente no primeiro boot
DOCKER_ADMIN_EMAIL=admin@oficina.com
DOCKER_ADMIN_PASSWORD=123456
DOCKER_ADMIN_NOME=Administrador

# Nuvem Fiscal (homologação / sandbox) — preencha para testar NF
NUVEM_FISCAL_CLIENT_ID=
NUVEM_FISCAL_CLIENT_SECRET=
NUVEM_FISCAL_CNPJ_EMITENTE=55961553000100
NUVEM_FISCAL_AMBIENTE=homologacao
NUVEM_FISCAL_PROVEDOR=nacional
NUVEM_FISCAL_API_URL=https://api.sandbox.nuvemfiscal.com.br
NUVEM_FISCAL_CODIGO_MUNICIPIO_IBGE=4105805
NUVEM_FISCAL_C_TRIB_NAC=140101
NUVEM_FISCAL_C_NBS=120013110
NUVEM_FISCAL_ALIQUOTA_ISS=2
NUVEM_FISCAL_EMITENTE_IE=
NUVEM_FISCAL_NFE_CRT=1
NUVEM_FISCAL_NFE_NUMERO_INICIAL=1

# ── Frontend (build) ──────────────────────────────────────────────────────────
# URL da API vista pelo navegador (porta publicada do backend)
VITE_API_URL=http://localhost:3011/api

# ── Dev (docker-compose.dev.yml) ──────────────────────────────────────────────
VITE_DEV_PROXY_TARGET=http://backend:3011
